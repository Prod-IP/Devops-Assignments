{
  "name": "ecommerce-lambda",
  "version": "1.0.0",
  "private": true,
  "description": "Production serverless e-commerce on AWS Lambda + NestJS + Terraform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test -- --coverage --coverageThreshold='{\"global\":{\"lines\":80}}'",
    "test:int": "jest --config jest.integration.config.ts --runInBand",
    "dev": "npx serverless offline --stage local --httpPort 3000 --reloadHandler",
    "infra:start": "docker compose up -d floci",
    "infra:stop": "docker compose down",
    "infra:seed": "tsx scripts/seed-local.ts",
    "infra:snapshot": "floci snapshot save dev-seed",
    "infra:restore": "floci snapshot restore dev-seed",
    "smoke": "tsx scripts/smoke-test.ts",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "aws-sdk-client-mock": "^4.1.0",
    "@nestjs/testing": "^10.4.15",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "serverless": "^3.39.0",
    "serverless-esbuild": "^1.54.3",
    "serverless-offline": "^13.8.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.0"
}
